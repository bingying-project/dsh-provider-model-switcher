{
  "name": "dsh-provider-model-switcher",
  "version": "1.0.0",
  "description": "Provider-first model switcher for the DSH composer: shows which provider owns the selected model and jumps straight to that provider's settings.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./icon": "./icon.svg",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "locale/*.json",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model",
    "provider"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.2-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
